generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClusterStatus {
  PROPOSED
  ACTIVE
  DISMISSED
  ARCHIVED
}

enum ClusterSuggestionStatus {
  PENDING
  APPROVED
  DISMISSED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  UNSUPPORTED
}

enum ResourceType {
  URL
  TEXT
  YOUTUBE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  resources Resource[]
  clusters  Cluster[]
  clusterSuggestions ClusterSuggestion[]
}

model Resource {
  id            String    @id @default(cuid())
  ownerId       String
  url           String?
  title         String
  description   String?
  notes         String?
  platform      String?
  sourceType    String?
  creator       String?
  metadata      Json?
  whySaved      String?
  type          ResourceType @default(URL)
  content          String?
  processingStatus TranscriptStatus?
  embedding      Unsupported("vector(1536)")?
  openedCount   Int       @default(0)
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner    User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clusters ResourceCluster[]
  chunks   ResourceChunk[]

  @@index([ownerId])
  @@index([url])
  @@index([createdAt])
}

model ResourceChunk {
  id         String    @id @default(cuid())
  resourceId String
  index      Int
  text       String
  startTime  Float?
  endTime    Float?
  embedding  Unsupported("vector(1536)")?
  metadata   Json?
  createdAt  DateTime  @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, index])
  @@index([resourceId])
}

model Cluster {
  id          String        @id @default(cuid())
  ownerId     String
  name        String
  description String?
  confidence  Float?
  status      ClusterStatus @default(PROPOSED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  resources ResourceCluster[]
  suggestion ClusterSuggestion?

  @@index([ownerId])
  @@index([status])
  @@index([ownerId, status])
}

model ResourceCluster {
  resourceId String
  clusterId  String
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  cluster  Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@id([resourceId, clusterId])
  @@index([clusterId])
}

model ClusterSuggestion {
  id                String                @id @default(cuid())
  ownerId           String
  name              String
  description       String?
  resourceIds       String[]
  status            ClusterSuggestionStatus @default(PENDING)
  approvedClusterId String?            @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cluster Cluster? @relation(fields: [approvedClusterId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
}
